# GEO Automated Downloader & Archiver - Example Environment
#
# Copy this file to .env and edit the values for your environment.
# Never commit the real .env file or any file containing real credentials.

# --- Paths ---
# Repository root (auto-detected by default; override only if needed)
# GEO_RING_PROJECT_ROOT=D:\GEO-Automated-Downloader-Archiver

# Download target disk
# GEO_RING_EXTERNAL_GEO_CLOUD_ROOT=E:\GEO_Cloud_2024

# EUMETSAT API credentials file
# GEO_RING_EUMETSAT_CREDENTIALS_FILE=config/eumetsat_credentials.txt

# --- SSH ---
# GEO_RING_SSH_TARGET=user@server.example.edu
# GEO_RING_SSH_IDENTITY_FILE=~/.ssh/id_ed25519_server_automation

# --- Conda (optional, for legacy PS1 scripts) ---
# GEO_RING_CONDA_EXE=C:\ProgramData\miniconda3\Scripts\conda.exe
# GEO_RING_PYTHON_EXE=C:\ProgramData\miniconda3\envs\pytorch\python.exe

# --- EUMETSAT API (alternative to credentials file) ---
# EUMETSAT_CONSUMER_KEY=your_key_here
# EUMETSAT_CONSUMER_SECRET=your_secret_here

# --- NASA Earthdata Login (DSCOVR EPIC L2 Cloud) ---
# Register at https://urs.earthdata.nasa.gov/ and approve the ASDC application.
# Option 1: environment variable
# EARTHDATA_USERNAME=kingofkunlun
# EARTHDATA_PASSWORD=your_earthdata_password_here
# Option 2: credential file (preferred, same pattern as EUMETSAT)
# Create config/earthdata_credentials.txt with:
#   username: kingofkunlun
#   password: your_password_here
# GEO_RING_EARTHDATA_CREDENTIALS_FILE=config/earthdata_credentials.txt

# --- Network ---
# Set to "*" to bypass all proxies (recommended for direct S3/HTTPS access)
# NO_PROXY=*
